APP_NAME="Presensi Event Alumni"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL/MariaDB for Production, SQLite for Local Testing)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=presensi_event
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@pesantren.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 Configuration (Optional for cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CORS & Frontend Origins (Comma-separated for multiple domains)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Sanctum Stateful Domains & Token Lifetime
SANCTUM_STATEFUL_DOMAINS="localhost:3000,127.0.0.1:3000"
SANCTUM_TOKEN_EXPIRATION_MINUTES=120

# Initial Super Admin Configuration (for database seeding)
INITIAL_ADMIN_NAME="Admin Pesantren"
INITIAL_ADMIN_EMAIL="admin@pesantren.com"
INITIAL_ADMIN_PASSWORD="YourSecureAdminPasswordHere"
INITIAL_ADMIN_PHONE="081234567890"
INITIAL_ADMIN_GENDER="Laki-laki"

# Google OAuth 2.0 Configuration
# Dapatkan dari Google Cloud Console: APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_BASE_URL="${APP_URL}"

# WhatsApp Gateway (Fonnte) Configuration (Optional)
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send
