APP_NAME="Presensi Event Alumni E2E"
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Create this dedicated database once. The reset command requires both names to
# match and end in _e2e. Never use the development or production database name.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=presensi_event_e2e
E2E_DB_DATABASE=presensi_event_e2e
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
SANCTUM_STATEFUL_DOMAINS="localhost:3000,127.0.0.1:3000"

# Local E2E identities only. Keep the same values in the frontend .env.e2e.
E2E_ADMIN_EMAIL=e2e.admin@example.test
E2E_ADMIN_PASSWORD=E2E-Admin-2026!
E2E_ALUMNI_EMAIL=e2e.alumni@example.test
E2E_ALUMNI_PASSWORD=E2E-Alumni-2026!

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_BASE_URL="${APP_URL}"
FONNTE_TOKEN=
